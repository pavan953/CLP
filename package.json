{
  "name": "clp-appointment-booking-app",
  "version": "1.0.0",
  "description": "Mini Appointment Booking Application with React, Node.js, Express, and MongoDB",
  "scripts": {
    "build": "cd client && npm run build",
    "dev:server": "node --watch server/src/server.js",
    "dev:client": "npm --prefix client run dev",
    "start:server": "node server/src/server.js",
    "build:client": "npm --prefix client run build",
    "install:all": "npm --prefix server install && npm --prefix client install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0"
  },
  "keywords": ["react", "node", "mongodb", "express", "appointment-booking", "healthcare"],
  "author": "",
  "license": "ISC"
}
